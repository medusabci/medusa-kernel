# Add any directories, files, or patterns you don't want to be tracked by version control
.idea/
.idea/*
# Claude Code local config
.claude/
*.egg-info/
*.pyc
*.pyo
*.mds
*.csv
*.mat
venv/
python-env/
build/
dist/
*.egg*

# uv
.venv/
.venv-*/

# pyproject build artifacts (already covered by build/ and dist/, listed for clarity)
*.whl
*.tar.gz

# mkdocs build output (generated by `mkdocs build`)
site/

# pytest / mypy / ruff caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# bytecode caches inside the package (src-layout)
src/**/__pycache__/

# Figures generated by the examples (regenerate by running the scripts)
examples/*_figures/
examples/*.png
