 "cells": [
  {
   "cell_type": "code",
   "id": "a1403301",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-06-04T18:06:33.715590800Z",
     "start_time": "2026-06-04T18:06:31.500128Z"
